{
  "name": "reminder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,api -c cyan,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "build:pwa": "vite build && node scripts/verify-deploy.mjs",
    "build:native": "NATIVE_BUILD=true vite build && cap sync",
    "build:android": "NATIVE_BUILD=true vite build && cap sync android",
    "build:apk:debug": "node scripts/check-apk-env.mjs && NATIVE_BUILD=true vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "check:apk": "node scripts/check-apk-env.mjs",
    "deploy:check": "node scripts/verify-deploy.mjs",
    "deploy:pwa": "npm run build:pwa",
    "deploy:oracle": "bash scripts/deploy-oracle.sh",
    "deploy:all": "bash scripts/deploy-all.sh",
    "deploy:ssl": "bash scripts/setup-ssl.sh",
    "deploy:apk": "bash scripts/deploy-apk.sh",
    "prepare:ios": "bash scripts/prepare-ios.sh",
    "ios:cert": "bash scripts/ios-certificate-setup.sh",
    "generate:vapid": "node scripts/generate-vapid.mjs",
    "preview": "vite preview",
    "start:server": "node server/index.js",
    "start:prod": "SERVE_STATIC=true node server/index.js",
    "test": "node scripts/test.mjs",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android && node scripts/setup-native-icons.mjs",
    "cap:add:ios": "cap add ios",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "icons:native": "node scripts/setup-native-icons.mjs",
    "icons:generate": "node scripts/generate-icon-5bars.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.10.6",
    "puppeteer": "^23.11.1",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
