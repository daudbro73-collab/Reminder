# Deploy target (Oracle server IP)
DEPLOY_HOST=92.5.234.30

# HTTPS domain (DNS A-record must point to DEPLOY_HOST), then: npm run deploy:ssl your.domain.com
# DEPLOY_DOMAIN=muzakkir.example.com

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@muzakkir.app
# Same public key for Vite client (must match VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=
# Example for self-hosted backend: https://api.example.com
VITE_API_URL=

# Express server port (default 3001)
PORT=3001

# Serve built PWA from dist/ via Express (npm run start:prod)
SERVE_STATIC=true
